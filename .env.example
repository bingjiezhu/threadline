# Copy to .env. npm start loads it. Never commit the real .env.
PORT=4173
HOST=127.0.0.1
NODE_ENV=development
# Relative to the project root when started with npm start.
THREADLINE_DB=.data/threadline.sqlite
# Empty: only first-account setup is allowed; subsequent registration closes.
# Set a long random code to permit additional, separate private accounts.
REGISTRATION_TOKEN=
# For HTTPS deployments: exact browser origin, e.g. https://relationships.example.com
APP_ORIGIN=
# Optional. Basic management and local evidence matching work without a model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_DAILY_LIMIT=30

# Optional chat channels. Configure only with operator permission and a protected HTTPS host.
# A single allowed Slack team per deployment; each user still links a separate private account.
SLACK_SIGNING_SECRET=
SLACK_TEAM_ID=
# Optional: enables native Slack confirmation modals. No chat history scopes are needed.
SLACK_BOT_TOKEN=
# Discord user-installed application. Signature verification uses its public key.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
# Only used by the explicit command registration CLI, never by the runtime.
DISCORD_BOT_TOKEN=

# Optional alternative provider. Explicitly choose one; there is no silent fallback.
# THREADLINE_AI_PROVIDER=vertex
# THREADLINE_VERTEX_PROJECT=your-google-cloud-project
# THREADLINE_VERTEX_MODEL=your-available-gemini-model
# Authenticate with gcloud application-default login on the operator machine.
# Optional short-lived token alternative; never commit or package the token.
# THREADLINE_VERTEX_ACCESS_TOKEN=
